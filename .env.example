# In production, point this at the host's mounted persistent disk/volume.
# Do not use /tmp: it is cleared when a serverless instance stops.
DATA_DIR=/var/lib/vsla-data
# By default uploads are saved in DATA_DIR/uploads. Set this only when using a
# different persistent mounted volume for uploaded images.
# UPLOADS_DIR=/var/lib/vsla-uploads

# Optional deployment URL for a custom hosted environment.
# Leave unset for the default local file-based storage.
# APP_URL=
